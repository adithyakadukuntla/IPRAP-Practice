# Copy to terraform.tfvars and adjust. Never commit terraform.tfvars if it
# contains anything sensitive (it shouldn't -- secrets live in Secrets Manager).

aws_region  = "us-east-1"
project_name = "ipra"
environment  = "dev"

azs = ["us-east-1a", "us-east-1b"]

# Set to false to save NAT Gateway cost if the API does not need outbound
# internet in your training account (e.g. Snowflake reachable via PrivateLink).
enable_nat_gateway = true

# Fill in once you have an ACM certificate; leave blank for HTTP-only training setup.
certificate_arn = ""

# Enable once the GitHub repo is known, for OIDC-based deploys.
enable_github_oidc = false
github_org  = "your-org"
github_repo = "investment-portfolio-risk-analytics"
